---
interface Props {
  title: string;
  description?: string;
  lang?: 'ja' | 'en';
  jpHref?: string;
  enHref?: string;
}
const {
  title,
  lang = 'ja',
  jpHref = '/ja/',
  enHref = '/en/',
} = Astro.props;
const isEnglish = lang === 'en';
const description = Astro.props.description ?? (
  isEnglish
    ? 'Stories and practical knowledge from communities across Okinawa.'
    : '沖縄の現場から見えるリアルを、世界へ届ける'
);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const jpUrl = new URL(jpHref, Astro.site);
const enUrl = new URL(enHref, Astro.site);
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | {isEnglish ? 'Ryukyu no Tane' : '琉球のタネ'}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="ja" href={jpUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={jpUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <header>
    <div class="header-inner">
      <a href={isEnglish ? '/en/' : '/ja/'} class="site-title">
        <span class="logo-main">琉球のタネ</span>
        <span class="logo-sub">Ryukyu no Tane</span>
      </a>
      <nav class="lang-nav">
        <a href={jpHref}>JP</a>
        <a href={enHref}>EN</a>
      </nav>
    </div>
    <nav class="series-nav">
      <a href={isEnglish ? '/en/news/260708-tosyokan/' : '/ja/news/opportunity-sample/'}>
        {isEnglish ? '📰 Latest News' : '📰 最新記事'}
      </a>
      {!isEnglish && <a href="/ja/series-f/">🎙 沖縄の記憶</a>}
    </nav>
  </header>

  <div class="ui-controls" id="uiControls">
    <button class="ui-toggle" id="uiToggle" title={isEnglish ? 'Display settings' : '表示設定'}>⚙️</button>
    <div class="ui-panel" id="uiPanel">
      <p class="ui-label">{isEnglish ? 'Font size' : '文字サイズ'}</p>
      <div class="ui-row">
        <button onclick="changeFontSize(-1)">A-</button>
        <button onclick="changeFontSize(0)">{isEnglish ? 'Default' : '標準'}</button>
        <button onclick="changeFontSize(1)">A+</button>
      </div>
      <p class="ui-label">{isEnglish ? 'Color' : 'カラー'}</p>
      <div class="ui-row">
        <button onclick="changeTheme('default')" class="theme-btn default">{isEnglish ? 'Default' : '標準'}</button>
        <button onclick="changeTheme('dark')" class="theme-btn dark">{isEnglish ? 'Dark' : 'ダーク'}</button>
        <button onclick="changeTheme('warm')" class="theme-btn warm">{isEnglish ? 'Warm' : '温かみ'}</button>
      </div>
    </div>
  </div>

  <main>
    <slot />
  </main>

  <footer>
    <p>© 2026 琉球のタネ / Ryukyu no Tane</p>
    <p class="site-switch">
      {isEnglish ? 'Current: ' : '現在：'}
      <strong>{isEnglish ? 'Astro experimental version' : 'Astro版（試験中）'}</strong>
      {' ／ '}
      <a href={isEnglish ? 'https://world.ryukyu-tane.com/en/' : 'https://world.ryukyu-tane.com/ja/'}>
        {isEnglish ? 'Switch to the Hugo version →' : 'Hugo版に切り替える →'}
      </a>
    </p>
  </footer>

  <script is:raw>
    var sizes = [14, 16, 18, 20];
    var sizeIdx = parseInt(localStorage.getItem('fontSize') || '1');
    document.body.style.fontSize = sizes[sizeIdx] + 'px';
    document.body.setAttribute('data-theme', localStorage.getItem('theme') || 'default');

    function changeFontSize(dir) {
      if (dir === 0) sizeIdx = 1;
      else sizeIdx = Math.max(0, Math.min(sizes.length - 1, sizeIdx + dir));
      document.body.style.fontSize = sizes[sizeIdx] + 'px';
      localStorage.setItem('fontSize', sizeIdx);
    }

    function changeTheme(theme) {
      document.body.setAttribute('data-theme', theme);
      localStorage.setItem('theme', theme);
    }

    document.getElementById('uiToggle').addEventListener('click', function() {
      document.getElementById('uiPanel').classList.toggle('open');
    });
  </script>
</body>
</html>
