---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const opportunities = [
  {
    title: '沖縄障害者職業センターの無料職業支援',
    forWhom: '就職や職場復帰に向けて、専門家との接点や次の支援先を増やしたい人',
    eligibility: '制度上の利用条件あり。詳細は公式案内で確認が必要です。',
    cost: '無料',
    access: '沖縄県内',
    timing: '随時',
    resources: ['人', '情報', '能力・知識', '機会'],
    next: '職業評価、職業準備支援、ジョブコーチ、職場復帰支援',
    score: 96,
    category: '就労・相談',
  },
  {
    title: '九州・沖縄の中小企業向け AI・DX人材育成セミナー',
    forWhom: 'AI・DXを学び直し、仕事や事業の選択肢を増やしたい人',
    eligibility: '主に九州・沖縄地域の中小企業関係者向け。',
    cost: '無料',
    access: 'オンライン',
    timing: '2026年9月18日',
    resources: ['人', '情報', '能力・知識', '機会'],
    next: 'リスキリング、関連講座、相談窓口',
    score: 91,
    category: '学び直し',
  },
  {
    title: '観光現場での食の多様性｜ユニバーサルツーリズムセミナー',
    forWhom: '観光や接客の現場で、新しい知識や実践方法に触れたい人',
    eligibility: '観光事業者などを主な対象とする講座。',
    cost: '無料',
    access: 'オンライン',
    timing: '2026年9月18日',
    resources: ['人', '情報', '能力・知識', '機会'],
    next: '現場改善、次回講座、関連情報',
    score: 82,
    category: '観光・学び',
  },
  {
    title: '沖縄公庫フォーラム2026｜人口構造の変化を見据えた沖縄経済の未来',
    forWhom: '地域や仕事のこれからを考えるために、沖縄経済の情報や視点を増やしたい人',
    eligibility: '沖縄の事業者・地域活動者など、テーマに関心のある人向け。',
    cost: '無料',
    access: 'オンライン',
    timing: '2026年10月2日',
    resources: ['人', '情報', '能力・知識', '機会'],
    next: '地域経済情報、経営情報、関連フォーラム',
    score: 80,
    category: '地域経済',
  },
  {
    title: 'マニュアル化の前にやること！！業務改善の進め方',
    forWhom: '今の仕事を改善したい、相談相手や実務的な学びの入口を増やしたい人',
    eligibility: '県内の中小企業・小規模事業者などが主な対象。',
    cost: '無料',
    access: '沖縄県内会場',
    timing: '2026年9月25日',
    resources: ['人', '情報', '能力・知識', '機会'],
    next: '個別相談、中小企業支援、業務改善支援',
    score: 72,
    category: '仕事・業務改善',
  },
];
---

<BaseLayout
  title="NEWS｜琉球のタネ 機会朝刊サンプル"
  description="社会資源との接点が少ない人にも届く、沖縄の機会の入口を集めたNEWS｜琉球のタネの公開サンプルです。"
  lang="ja"
  jpHref="/ja/news/opportunity-sample/"
  enHref="/en/"
>
  <section class="opportunity-hero">
    <p class="eyebrow">NEWS｜琉球のタネ / SAMPLE</p>
    <h1>沖縄の「機会真空」を、<br />機会密集へ。</h1>
    <p class="lead">今いる場所から、次の可能性を増やす入口を。</p>
    <p class="intro">
      NEWS｜琉球のタネは、学び・仕事・人・情報・お金・体験などの社会資源に触れる機会が少ない人へ、
      無料または低コストで使える「次の入口」を届けるニュースです。
    </p>
    <div class="concept-flow" aria-label="機会真空から機会密集への流れ">
      <span>機会真空</span><b>→</b><span>機会接続</span><b>→</b><span>機会密集</span>
    </div>
  </section>

  <section class="target-box">
    <p class="box-kicker">このNEWSが特に届けたい人</p>
    <h2>「情報はある。でも、自分につながる入口が少ない」と感じている人へ。</h2>
    <div class="target-grid">
      <div><strong>人との接点が少ない</strong><span>相談相手、専門家、仲間、地域とのつながりを増やしたい</span></div>
      <div><strong>学びの機会が少ない</strong><span>お金や場所、所属に左右されず、新しい知識に触れたい</span></div>
      <div><strong>仕事の選択肢を増やしたい</strong><span>就職、学び直し、職業体験など次の一歩を探している</span></div>
      <div><strong>情報が届きにくい</strong><span>知られていない制度や無料の機会を見つけたい</span></div>
    </div>
    <p class="target-note">
      年齢や肩書きで人を分類するのではなく、社会資源へのアクセスが薄い状態を「機会真空」と捉えます。
    </p>
  </section>

  <section class="sample-note">
    <strong>公開サンプル</strong>
    <span>今回はリンク規約確認前のため、外部リンクを掲載していません。</span>
  </section>

  <section class="opportunity-list">
    {opportunities.map((item, index) => (
      <article class="opportunity-card">
        <div class="card-topline">
          <span class="number">{String(index + 1).padStart(2, '0')}</span>
          <span class="category">{item.category}</span>
          <span class="score">{item.score}<small>/100</small></span>
        </div>
        <h2>{item.title}</h2>
        <p class="for-whom"><strong>こんな人の「次の入口」に</strong><br />{item.forWhom}</p>

        <dl class="facts">
          <div><dt>費用</dt><dd>{item.cost}</dd></div>
          <div><dt>参加方法</dt><dd>{item.access}</dd></div>
          <div><dt>開催・利用</dt><dd>{item.timing}</dd></div>
          <div><dt>利用条件</dt><dd>{item.eligibility}</dd></div>
          <div><dt>増える社会資源</dt><dd class="tags">{item.resources.map((r) => <span>#{r}</span>)}</dd></div>
          <div><dt>その先</dt><dd>{item.next}</dd></div>
        </dl>
      </article>
    ))}
  </section>

  <section class="closing-box">
    <h2>NEWSの基準は「その情報で、次の可能性が増えるか」</h2>
    <p>
      有名な制度や大きなニュースだけを集めるのではなく、入口が広く、無料または低コストで、
      人・情報・学び・仕事など次の社会資源につながるものを優先して探します。
    </p>
  </section>
</BaseLayout>

<style>
  :global(main) { max-width: 980px; }
  .opportunity-hero { padding: 3.5rem 0 2rem; }
  .eyebrow { font-size: .78rem; letter-spacing: .14em; font-weight: 700; opacity: .62; }
  h1 { font-size: clamp(2.35rem, 8vw, 5rem); line-height: 1.06; letter-spacing: -.04em; margin: .6rem 0 1.15rem; }
  .lead { font-size: clamp(1.25rem, 3vw, 1.75rem); font-weight: 700; margin: 0 0 .8rem; }
  .intro { max-width: 760px; line-height: 1.9; opacity: .86; }
  .concept-flow { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; margin-top: 1.8rem; font-weight: 700; }
  .concept-flow span { border: 1px solid currentColor; border-radius: 999px; padding: .55rem .9rem; }
  .concept-flow b { opacity: .4; }

  .target-box { margin: .5rem 0 2rem; padding: clamp(1.4rem, 5vw, 2.3rem); border-radius: 22px; background: rgba(128,128,128,.08); }
  .box-kicker { font-size: .8rem; font-weight: 700; letter-spacing: .08em; opacity: .6; }
  .target-box h2 { font-size: clamp(1.35rem, 3.4vw, 2rem); line-height: 1.5; margin: .45rem 0 1.3rem; }
  .target-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .8rem; }
  .target-grid div { border: 1px solid rgba(128,128,128,.25); border-radius: 14px; padding: 1rem; }
  .target-grid strong, .target-grid span { display: block; }
  .target-grid span { margin-top: .35rem; line-height: 1.7; font-size: .92rem; opacity: .78; }
  .target-note { margin: 1.2rem 0 0; font-size: .9rem; line-height: 1.8; opacity: .72; }

  .sample-note { display: flex; flex-wrap: wrap; gap: .65rem 1rem; padding: 1rem 1.1rem; border: 1px dashed currentColor; border-radius: 14px; margin: 0 0 1.8rem; font-size: .92rem; }
  .opportunity-list { display: grid; gap: 1.2rem; }
  .opportunity-card { border: 1px solid rgba(128,128,128,.28); border-radius: 20px; padding: clamp(1.2rem, 4vw, 2rem); background: color-mix(in srgb, currentColor 2%, transparent); }
  .card-topline { display: grid; grid-template-columns: auto 1fr auto; gap: .75rem; align-items: center; margin-bottom: .8rem; }
  .number { font-size: .78rem; font-weight: 700; opacity: .5; }
  .category { justify-self: start; font-size: .78rem; font-weight: 700; border: 1px solid rgba(128,128,128,.32); border-radius: 999px; padding: .28rem .65rem; }
  .score { font-size: 1.5rem; font-weight: 700; letter-spacing: -.04em; }
  .score small { font-size: .7rem; opacity: .5; margin-left: .1rem; }
  .opportunity-card h2 { font-size: clamp(1.25rem, 3vw, 1.7rem); line-height: 1.45; margin: 0 0 .8rem; }
  .for-whom { line-height: 1.8; margin: 0 0 1.25rem; padding: .9rem 1rem; border-left: 4px solid currentColor; background: rgba(128,128,128,.06); }
  .facts { display: grid; gap: 0; margin: 0; border-top: 1px solid rgba(128,128,128,.2); }
  .facts > div { display: grid; grid-template-columns: 7.5rem 1fr; gap: .8rem; padding: .7rem 0; border-bottom: 1px solid rgba(128,128,128,.16); }
  dt { font-size: .82rem; font-weight: 700; opacity: .58; }
  dd { margin: 0; line-height: 1.65; }
  .tags { display: flex; flex-wrap: wrap; gap: .35rem .7rem; }
  .tags span { white-space: nowrap; }
  .closing-box { margin: 2rem 0 4rem; padding: clamp(1.4rem, 5vw, 2.4rem); border-radius: 20px; background: rgba(128,128,128,.08); }
  .closing-box h2 { font-size: clamp(1.25rem, 3vw, 1.6rem); margin-top: 0; }
  .closing-box p { margin-bottom: 0; line-height: 1.9; }

  @media (max-width: 640px) {
    .opportunity-hero { padding-top: 2.4rem; }
    .target-grid { grid-template-columns: 1fr; }
    .facts > div { grid-template-columns: 1fr; gap: .25rem; }
  }
</style>
