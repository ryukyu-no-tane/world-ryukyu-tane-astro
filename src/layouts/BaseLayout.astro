---
interface Props {
  title: string;
  description?: string;
  seoTitle?: string;
  image?: string;
  imageAlt?: string;
  article?: { datePublished: string; dateModified?: string };
  lang?: 'ja' | 'en';
  jpHref?: string;
  enHref?: string;
}
const {
  title,
  lang = 'ja',
  jpHref = '/ja/',
  enHref = '/en/',
} = Astro.props;
const isEnglish = lang === 'en';
const description = Astro.props.description ?? (
  isEnglish
    ? 'Stories and practical knowledge from communities across Okinawa.'
    : '沖縄の現場から見えるリアルを、世界へ届ける'
);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const jpUrl = new URL(jpHref, Astro.site);
const enUrl = new URL(enHref, Astro.site);
const seoTitle = Astro.props.seoTitle ?? title;
const siteName = isEnglish ? 'Ryukyu no Tane' : '琉球のタネ';
const fullTitle = seoTitle === siteName ? siteName : `${seoTitle} | ${siteName}`;
const imageUrl = Astro.props.image ? new URL(Astro.props.image, Astro.site).href : undefined;
const article = Astro.props.article;
const structuredData = article ? {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description, inLanguage: lang,
  url: canonicalUrl.href, mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl.href },
  datePublished: article.datePublished, dateModified: article.dateModified ?? article.datePublished,
  publisher: { '@type': 'Organization', name: siteName, url: new URL(isEnglish ? '/en/' : '/ja/', Astro.site).href },
  ...(imageUrl ? { image: [imageUrl] } : {}),
} : {
  '@context': 'https://schema.org', '@type': 'WebPage',
  name: title, description, inLanguage: lang, url: canonicalUrl.href,
  isPartOf: { '@type': 'WebSite', name: siteName, url: new URL('/', Astro.site).href },
};
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content={article ? "article" : "website"} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl.href} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content={isEnglish ? "en_US" : "ja_JP"} />
  {imageUrl && <meta property="og:image" content={imageUrl} />}
  {imageUrl && Astro.props.imageAlt && <meta property="og:image:alt" content={Astro.props.imageAlt} />}
  <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {imageUrl && <meta name="twitter:image" content={imageUrl} />}
  <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="ja" href={jpUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={jpUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <header>
    <div class="header-inner">
      <a href={isEnglish ? '/en/' : '/ja/'} class="site-title">
        <span class="logo-main">琉球のタネ</span>
        <span class="logo-sub">Ryukyu no Tane</span>
      </a>
      <nav class="lang-nav">
        <a href={jpHref}>JP</a>
        <a href={enHref}>EN</a>
      </nav>
    </div>
    <nav class="series-nav">
      <a href={isEnglish ? '/en/news/260708-tosyokan/' : '/ja/news/260708-tosyokan/'}>
        {isEnglish ? '📰 Latest News' : '📰 最新記事'}
      </a>
      {!isEnglish && <a href="/ja/series-f/">🎙 沖縄の記憶</a>}
    </nav>
  </header>

  <!-- 表示設定パネル -->
  <div class="ui-controls" id="uiControls">
    <button class="ui-toggle" id="uiToggle" title={isEnglish ? 'Display settings' : '表示設定'}>⚙️</button>
    <div class="ui-panel" id="uiPanel">
      <p class="ui-label">{isEnglish ? 'Font size' : '文字サイズ'}</p>
      <div class="ui-row">
        <button onclick="changeFontSize(-1)">A-</button>
        <button onclick="changeFontSize(0)">{isEnglish ? 'Default' : '標準'}</button>
        <button onclick="changeFontSize(1)">A+</button>
      </div>
      <p class="ui-label">{isEnglish ? 'Color' : 'カラー'}</p>
      <div class="ui-row">
        <button onclick="changeTheme('default')" class="theme-btn default">{isEnglish ? 'Default' : '標準'}</button>
        <button onclick="changeTheme('dark')" class="theme-btn dark">{isEnglish ? 'Dark' : 'ダーク'}</button>
        <button onclick="changeTheme('warm')" class="theme-btn warm">{isEnglish ? 'Warm' : '温かみ'}</button>
      </div>
    </div>
  </div>

  <main>
    <slot />
  </main>

  <footer>
    <p>© 2026 琉球のタネ / Ryukyu no Tane</p>
    <p class="site-switch">
      {isEnglish ? 'Current: ' : '現在：'}
      <strong>{isEnglish ? 'Astro experimental version' : 'Astro版（試験中）'}</strong>
      {' ／ '}
      <a href={isEnglish ? 'https://world.ryukyu-tane.com/en/' : 'https://world.ryukyu-tane.com/ja/'}>
        {isEnglish ? 'Switch to the Hugo version →' : 'Hugo版に切り替える →'}
      </a>
    </p>
  </footer>

  <script is:raw>
    var sizes = [14, 16, 18, 20];
    var sizeIdx = parseInt(localStorage.getItem('fontSize') || '1');
    document.body.style.fontSize = sizes[sizeIdx] + 'px';
    document.body.setAttribute('data-theme', localStorage.getItem('theme') || 'default');

    function changeFontSize(dir) {
      if (dir === 0) sizeIdx = 1;
      else sizeIdx = Math.max(0, Math.min(sizes.length - 1, sizeIdx + dir));
      document.body.style.fontSize = sizes[sizeIdx] + 'px';
      localStorage.setItem('fontSize', sizeIdx);
    }

    function changeTheme(theme) {
      document.body.setAttribute('data-theme', theme);
      localStorage.setItem('theme', theme);
    }

    document.getElementById('uiToggle').addEventListener('click', function() {
      document.getElementById('uiPanel').classList.toggle('open');
    });
  </script>
</body>
</html>
